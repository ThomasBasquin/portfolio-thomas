---
import { versioned } from "../lib/asset";

type Media =
  | { kind: "claudebar" }
  | { kind: "image"; src: string; alt: string; width: number; height: number };

interface Props {
  media?: Media;
}

const { media } = Astro.props;
---

<div class:list={["side-media", media ? `side-media--${media.kind}` : "side-media--pending"]}>
  {media?.kind === "claudebar" && (
    <div class="mb" role="img" aria-label="La barre des menus du Mac : le crabe de ClaudeBar passe du blanc à l'orange quand une session attend une réponse.">
      <img src={versioned("/media/side/claudebar-idle.webp")} alt="" width="1120" height="700" loading="lazy" decoding="async" />
      <img class="mb-waiting" src={versioned("/media/side/claudebar-waiting.webp")} alt="" width="1120" height="700" loading="lazy" decoding="async" />
    </div>
  )}
  {media?.kind === "image" && (
    <img
      src={versioned(media.src)}
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading="lazy"
      decoding="async"
    />
  )}
  {!media && (
    <p class="device-pending micro">
      <span class="device-pending-dot" aria-hidden="true"></span>
      Capture à venir
    </p>
  )}
</div>
