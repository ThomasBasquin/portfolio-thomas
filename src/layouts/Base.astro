---
import "../styles/global.css";
import "../styles/effects.css";
import { SITE } from "../lib/site";
import { SITE_ACCENT, type AccentRoles } from "../lib/colors";

interface Props {
  title?: string;
  description?: string;
  accent?: AccentRoles;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  accent = SITE_ACCENT,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const accentStyle = `--accent: ${accent.accent}; --accent-ink: ${accent.ink}; --accent-deep: ${accent.deep};`;
---

<!doctype html>
<html lang="fr" style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={accent.theme} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/archivo-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
    <script>
      import "../scripts/effects";
    </script>
  </body>
</html>
