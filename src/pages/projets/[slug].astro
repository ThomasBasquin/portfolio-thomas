---
import { getCollection, render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import DeviceFrame from "../../components/DeviceFrame.astro";
import { accentRoles } from "../../lib/colors";
import { versioned } from "../../lib/asset";
import { SITE } from "../../lib/site";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, prev, next } = Astro.props;
const { title, tagline, description, role, stack, year, status, links, media, device } =
  project.data;
const wip = status === "wip";
const galleryDevice = media.galleryDevice ?? device;
const accent = accentRoles(project.data.accent);
const { Content } = await render(project);

const alt =
  device === "phone"
    ? `${title} sur un écran de téléphone, capturé sur le site en ligne`
    : `${title} dans un navigateur, capturé sur le site en ligne`;
---

<Base title={`${title} — ${SITE.name}`} description={description} accent={accent}>
  {media.poster && (
    <Fragment slot="head">
      <link
        rel="preload"
        as="image"
        href={versioned(media.poster)}
        fetchpriority="high"
      />
    </Fragment>
  )}
  <SiteHeader home={false} />
  <main id="contenu">
    <article>
      <header class="proj-head container grid">
        <a class="back-link micro" href="/">← Tous les projets</a>
        <h1>{title}</h1>
        <p class="proj-tagline">{tagline}</p>
        <div class="proj-device">
          <DeviceFrame
            kind={device}
            poster={media.poster}
            url={wip ? undefined : links.demo}
            alt={alt}
            eager
          />
        </div>
        <dl class="proj-meta">
          <div>
            <dt class="micro">Rôle</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt class="micro">Stack</dt>
            <dd>{stack.join(" · ")}</dd>
          </div>
          <div>
            <dt class="micro">Année</dt>
            <dd>{wip ? `${year} · en cours` : year}</dd>
          </div>
          {!wip && (links.demo || links.code) && (
            <div>
              <dt class="micro">Liens</dt>
              <dd>
                {links.demo && (
                  <a href={links.demo} rel="noopener" target="_blank">Voir le site ↗</a>
                )}
                {links.demo && links.code && " · "}
                {links.code && (
                  <a href={links.code} rel="noopener" target="_blank">Code source ↗</a>
                )}
              </dd>
            </div>
          )}
        </dl>
      </header>

      <div class="container grid">
        <div class="proj-body">
          <Content />
        </div>

        {media.gallery.length > 0 && (
          <div class:list={["proj-gallery", `proj-gallery--${galleryDevice}`]}>
            {media.gallery.map(({ src, caption }) => (
              <figure>
                <img
                  src={versioned(src)}
                  alt={`${title} — ${caption}`}
                  width={galleryDevice === "phone" ? 780 : 1600}
                  height={galleryDevice === "phone" ? 1688 : 1000}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="micro">{caption}</figcaption>
              </figure>
            ))}
          </div>
        )}

        <nav class="proj-nav" aria-label="Autres projets">
          <a href={`/projets/${prev.id}`} rel="prev">
            <span class="micro">← Projet précédent</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
          <a class="nav-next" href={`/projets/${next.id}`} rel="next">
            <span class="micro">Projet suivant →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        </nav>
      </div>
    </article>
  </main>
  <div class="container grid outro-footer">
    <SiteFooter home={false} />
  </div>
</Base>
