---
import { getCollection, render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import DeviceFrame from "../../components/DeviceFrame.astro";
import { accentRoles } from "../../lib/colors";
import { fullSize, versioned } from "../../lib/asset";
import { SITE } from "../../lib/site";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, prev, next } = Astro.props;
const { title, tagline, description, role, stack, year, status, links, media, device } =
  project.data;
const wip = status === "wip";
const galleryDevice = media.galleryDevice ?? device;
const accent = accentRoles(project.data.accent);
const { Content } = await render(project);

const navAccent = (hex: string) => {
  const roles = accentRoles(hex);
  return `--accent: ${roles.accent}; --accent-ink: ${roles.ink};`;
};

const alt =
  device === "phone"
    ? `${title} sur un écran de téléphone, capturé sur le site en ligne`
    : `${title} dans un navigateur, capturé sur le site en ligne`;
---

<Base title={`${title} — ${SITE.name}`} description={description} accent={accent}>
  {media.poster && (
    <Fragment slot="head">
      <link
        rel="preload"
        as="image"
        href={versioned(media.poster)}
        fetchpriority="high"
      />
    </Fragment>
  )}
  <SiteHeader home={false} />
  <main id="contenu">
    <article>
      <header class="proj-head container grid">
        <a class="back-link micro" href="/">← Tous les projets</a>
        <h1>{title}</h1>
        <p class="proj-tagline">{tagline}</p>
        <div class="proj-device">
          <DeviceFrame
            kind={device}
            poster={media.poster}
            url={wip ? undefined : links.demo}
            alt={alt}
            eager
          />
        </div>
        <dl class="proj-meta">
          <div>
            <dt class="micro">Rôle</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt class="micro">Stack</dt>
            <dd>{stack.join(" · ")}</dd>
          </div>
          <div>
            <dt class="micro">Année</dt>
            <dd>{wip ? `${year} · en cours` : year}</dd>
          </div>
          {!wip && (links.demo || links.code) && (
            <div>
              <dt class="micro">Liens</dt>
              <dd>
                {links.demo && (
                  <a href={links.demo} rel="noopener" target="_blank">Voir le site ↗</a>
                )}
                {links.demo && links.code && " · "}
                {links.code && (
                  <a href={links.code} rel="noopener" target="_blank">Code source ↗</a>
                )}
              </dd>
            </div>
          )}
        </dl>
      </header>

      <div class="container grid">
        <div class="proj-body">
          <Content />
        </div>

        {media.gallery.length > 0 && (
          <div class:list={["proj-gallery", `proj-gallery--${galleryDevice}`]}>
            {media.gallery.map(({ src, caption }) => (
              <figure>
                <a class="gallery-zoom" href={fullSize(src)} aria-label={`Agrandir : ${caption}`}>
                  <img
                    src={versioned(src)}
                    alt={`${title} — ${caption}`}
                    width={galleryDevice === "phone" ? 780 : 1920}
                    height={galleryDevice === "phone" ? 1688 : 1080}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption class="micro">{caption}</figcaption>
              </figure>
            ))}
          </div>
        )}

        <nav class="proj-nav" aria-label="Autres projets">
          <a href={`/projets/${prev.id}`} rel="prev" style={navAccent(prev.data.accent)}>
            <span class="micro"><span class="nav-long">Projet </span>précédent</span>
            <span class="nav-title">
              <svg class="nav-chevron" viewBox="0 0 12 20" aria-hidden="true"><path d="M10 2L2 10l8 8" /></svg>
              <span class="nav-name">{prev.data.title}</span>
            </span>
          </a>
          <a
            class="nav-next"
            href={`/projets/${next.id}`}
            rel="next"
            style={navAccent(next.data.accent)}
          >
            <span class="micro"><span class="nav-long">Projet </span>suivant</span>
            <span class="nav-title">
              <span class="nav-name">{next.data.title}</span>
              <svg class="nav-chevron" viewBox="0 0 12 20" aria-hidden="true"><path d="M2 2l8 8-8 8" /></svg>
            </span>
          </a>
        </nav>
      </div>
    </article>
  </main>
  <div class="container grid outro-footer">
    <SiteFooter home={false} />
  </div>

  {media.gallery.length > 0 && (
    <dialog class:list={["lightbox", `lightbox--${galleryDevice}`]} aria-label={`Captures de ${title}`}>
      <figure class="lightbox-figure">
        <img class="lightbox-img" alt="" />
        <figcaption class="lightbox-caption">
          <span class="micro lightbox-count"></span>
          <span class="lightbox-text"></span>
        </figcaption>
      </figure>
      <button class="lightbox-btn lightbox-close" type="button" aria-label="Fermer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      {media.gallery.length > 1 && (
        <>
          <button class="lightbox-btn lightbox-prev" type="button" aria-label="Capture précédente">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="lightbox-btn lightbox-next" type="button" aria-label="Capture suivante">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </>
      )}
    </dialog>
  )}
</Base>

<script>
  import "../../scripts/lightbox";
</script>
